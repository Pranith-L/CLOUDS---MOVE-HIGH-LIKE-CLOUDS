PORT=5000
MONGODB_URI=mongodb://localhost:27017/clouds
JWT_SECRET=clouds_super_secret_jwt_key_change_this_in_production
CLIENT_URL=http://localhost:5173
# OAuth: redirect_uri registered at Google/Meta must match this host + path.
# Local (Vite proxy): same as CLIENT_URL — callbacks hit /api/oauth/... on :5173.
# Production split (e.g. Vercel + Render): set to your **API** public origin, e.g. https://api.yourdomain.com
OAUTH_REDIRECT_BASE=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram "API with Instagram Login" (Meta Developer App → Instagram product). Often Creator/Business only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional override, e.g. instagram_business_basic
# INSTAGRAM_SCOPE=instagram_business_basic
HF_TOKEN=YOUR_HF_TOKEN_HERE
# Support inbox (new request notifications). Defaults to SMTP_USER if unset.
SUPPORT_NOTIFY_EMAIL=pranithjr17@gmail.com
# Outgoing mail (optional — if unset, emails are logged to console only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
