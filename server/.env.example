PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/clouds
# Generate: openssl rand -base64 48  (min 32 chars, unique per environment)
JWT_SECRET=replace_with_openssl_rand_base64_48
SEED_ADMIN_EMAIL=admin@clouds.store
# Generate: openssl rand -base64 18  (min 12 chars, never use Admin123!)
SEED_ADMIN_PASSWORD=replace_with_strong_seed_password
# Frontend URL (Vercel). Local: http://localhost:5173
# Production: https://clouds-move-high-like-clouds.vercel.app
CLIENT_URL=http://localhost:5173
# OAuth callback host. Local (Vite proxy): same as CLIENT_URL.
# Production split (Vercel + Render): your **Render API** URL (optional — auto-detected from request if unset)
# OAUTH_REDIRECT_BASE=https://clouds-move-high-like-clouds.onrender.com
OAUTH_REDIRECT_BASE=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram "API with Instagram Login" (Meta Developer App → Instagram product). Often Creator/Business only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional override, e.g. instagram_business_basic
# INSTAGRAM_SCOPE=instagram_business_basic
HF_TOKEN=YOUR_HF_TOKEN_HERE
# Support inbox (new request notifications). Defaults to SMTP_USER if unset.
SUPPORT_NOTIFY_EMAIL=pranithjr17@gmail.com
# Outgoing mail (optional — if unset, emails are logged to console only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=pranithjr17@gmail.com
SMTP_PASS=gvch boul wmrz hrpo
MAIL_FROM=pranithjr17@gmail.com
